{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "patternProperties": {
        "^lx_\\d+$": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "lexeme": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "$ref": "#/definitions/writing"
                        }
                    ]
                },
                "phonetic": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "object"
                        }
                    ]
                },
                "phonemic": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "object"
                        }
                    ]
                },
                "word_type": {
                    "type": "string"
                },
                "word_class": {
                    "type": "string"
                },
                "grammatical_features": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "paradigm_bases": {
                    "type": "array"
                },
                "etymology": {
                    "type": "string"
                },
                "loanword": {
                    "type": "string"
                },
                "homophone": {
                    "type": "integer"
                },
                "senses": {
                    "type": "object",
                    "patternProperties": {
                        "^se_\\d+$": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "gloss": {
                                    "oneOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "object"
                                        }
                                    ]
                                },
                                "definition": {
                                    "oneOf": [
                                        {
                                            "type": "string"
                                        },
                                        {
                                            "type": "object"
                                        }
                                    ]
                                },
                                "literal": {
                                    "type": "string"
                                },
                                "scientific": {
                                    "type": "string"
                                },
                                "usage": {
                                    "type": "string"
                                },
                                "inflectional_features": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                },
                                "examples": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "patternProperties": {
                                      "^ex_\\d+$": {
                                          "type": "object",
                                          "properties": {
                                            "sentence": {
                                              "oneOf": [
                                                  {
                                                      "type": "string"
                                                  },
                                                  {
                                                      "$ref": "#/definitions/writing"
                                                  }
                                              ]
                                            },
                                            "translation": {
                                              "type": "string"
                                            }
                                          }
                                      }
                                    }
                                },
                                "etymology": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "id",
                                "gloss",
                                "definition"
                            ]
                        }
                    }
                },
                "crossref": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "variants": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "lists": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "notes": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "date_created": {
                    "type": "string",
                    "format": "date-time"
                },
                "date_modified": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "required": [
                "id",
                "lexeme",
                "word_type",
                "word_class",
                "senses",
                "date_created",
                "date_modified"
            ],
            "additionalProperties": false
        }
    },
    "definitions": {
        "writing": {
            "type": "object",
            "additionalProperties": {
                "oneOf": [
                    { "type": "string" },
                    {
                        "type": "object",
                        "minProperties": 2,
                        "properties": {
                            "text": { "type": "string" },
                            "transliteration": {
                                "oneOf": [
                                    { "type": "string" },
                                    { "type": "object" }
                                ]
                            },
                            "transcription": {
                                "oneOf": [
                                    { "type": "string" },
                                    { "type": "object" }
                                ]
                            }
                        },
                        "required": ["text"],
                        "additionalProperties": false
                    }
                ]
            }
        }
    }
}
